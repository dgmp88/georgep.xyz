---
// Header/Navbar component - converted from _deprecated/components/navbar.js
const links = [
  { href: '/blog', label: 'Blog' },
  { href: 'https://geometry.georgep.xyz/', label: 'Backgrounds' },
  { href: '/games', label: 'Games' },
  { href: '/cv.pdf', label: 'CV' },
];
---

<div class="absolute navbar text-white px-4 sm:px-6">
  <div class="navbar-start">
    <div class="dropdown">
      <label tabindex="0" class="btn btn-ghost text-white hover:bg-white/10 lg:hidden">
        <!-- Hamburger icon (inline SVG replaces FontAwesome) -->
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>
      <ul
        tabindex="0"
        class="menu dropdown-content mt-3 p-2 w-48 panel"
      >
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <a href="/" class="px-2 whitespace-nowrap text-lg font-semibold tracking-tight text-white">George Prichard</a>
  </div>
  <div class="navbar-end hidden lg:flex">
    <ul class="menu menu-horizontal p-0 gap-1">
      {links.map((l) => <li><a href={l.href} class="text-white/80 hover:text-white hover:bg-white/10">{l.label}</a></li>)}
    </ul>
  </div>
</div>
