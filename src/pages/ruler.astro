---
import BaseHead from "../components/BaseHead.astro";
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <BaseHead
      title="Online Ruler – Actual Size, Calibrated to Your Screen"
      description="A free on-screen ruler that shows true actual size in cm, mm and inches. It recognises your iPhone, Android, iPad or Mac screen automatically, with a quick bank card check for anything else."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <meta property="og:image" content={new URL("/images/ruler-og.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "Online Ruler",
        url: "https://georgep.xyz/ruler/",
        description:
          "An on-screen ruler that shows true actual size by recognising your device's screen, with a bank card check for anything else.",
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Any",
        offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
      })}
    />
    <style is:global>
      :root {
        --bg: #fbfbfa;
        --text: #1a1a1a;
        --muted: #6b7280;
        --grid-half: rgba(30, 60, 110, 0.06);
        --grid-cm: rgba(30, 60, 110, 0.13);
        --tick: #1f2937;
        --accent: #3b82f6;
        --accent-soft: #dbeafe;
        --panel: rgba(255, 255, 255, 0.92);
        --border: #e5e7eb;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #121315;
          --text: #ececec;
          --muted: #9ca3af;
          --grid-half: rgba(160, 190, 240, 0.07);
          --grid-cm: rgba(160, 190, 240, 0.15);
          --tick: #e5e7eb;
          --accent: #60a5fa;
          --accent-soft: rgba(96, 165, 250, 0.16);
          --panel: rgba(28, 30, 34, 0.94);
          --border: #33363c;
        }
      }

      html,
      body {
        margin: 0;
        height: 100%;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: "Inter", system-ui, -apple-system, sans-serif;
      }

      #grid {
        position: fixed;
        inset: 0;
        width: 100vw;
        height: 100vh;
        cursor: crosshair;
        touch-action: none;
      }
      #grid.dragging {
        cursor: grabbing;
      }

      .hud {
        position: fixed;
        font-size: 12px;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
        pointer-events: none;
      }
      #readout {
        left: 16px;
        bottom: 14px;
      }
      #readout strong {
        color: var(--text);
        font-weight: 500;
      }

      #title {
        position: fixed;
        top: 18px;
        left: 16px;
        margin: 0;
        font-size: 13px;
        font-weight: 500;
        color: var(--muted);
        pointer-events: none;
      }

      #topbar {
        position: fixed;
        top: 12px;
        right: 16px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 12px;
        color: var(--muted);
      }

      .units {
        display: inline-flex;
        padding: 2px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--panel);
      }
      .units button {
        padding: 4px 9px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: var(--muted);
        font: inherit;
        font-size: 13px;
        cursor: pointer;
      }
      .units button[aria-pressed="true"] {
        background: var(--accent-soft);
        color: var(--accent);
        font-weight: 500;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 12px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--panel);
        color: var(--text);
        font: inherit;
        font-size: 13px;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
      }
      .btn:hover {
        background: var(--accent-soft);
        color: var(--accent);
      }
      .btn.primary {
        background: var(--accent);
        border-color: var(--accent);
        color: white;
        font-weight: 500;
      }
      .btn.primary:hover {
        filter: brightness(1.08);
      }

      #panel {
        position: fixed;
        top: 52px;
        right: 16px;
        width: 360px;
        max-width: calc(100vw - 32px);
        max-height: calc(100vh - 68px);
        overflow-y: auto;
        box-sizing: border-box;
        padding: 20px;
        border-radius: 12px;
        border: 1px solid var(--border);
        background: var(--panel);
        backdrop-filter: blur(8px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        font-size: 13px;
        line-height: 1.5;
      }
      #panel[hidden] {
        display: none;
      }
      #panel h2 {
        margin: 0 0 12px;
        font-size: 15px;
        font-weight: 600;
      }
      #panel h3 {
        margin: 18px 0 6px;
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--muted);
      }
      #panel p {
        margin: 6px 0;
      }
      .note {
        color: var(--muted);
        font-size: 12px;
      }
      #guess {
        font-size: 15px;
      }
      #search {
        box-sizing: border-box;
        width: 100%;
        padding: 7px 10px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: var(--bg);
        color: var(--text);
        font: inherit;
      }
      #search:focus {
        outline: 2px solid var(--accent-soft);
        border-color: var(--accent);
      }
      #results {
        list-style: none;
        margin: 6px 0 0;
        padding: 4px;
        max-height: 216px;
        overflow-y: auto;
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      #results button {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        width: 100%;
        padding: 6px 8px;
        border: 0;
        border-radius: 6px;
        background: none;
        color: var(--text);
        font: inherit;
        text-align: left;
        cursor: pointer;
      }
      #results button:hover,
      #results button.selected {
        background: var(--accent-soft);
      }
      #results .tag {
        color: var(--muted);
        font-size: 11px;
        white-space: nowrap;
      }
      #results .empty {
        padding: 6px 8px;
        color: var(--muted);
      }
      .link {
        margin-top: 12px;
        padding: 0;
        border: 0;
        background: none;
        color: var(--accent);
        font: inherit;
        font-size: 12px;
        cursor: pointer;
      }
      .link:hover {
        text-decoration: underline;
      }

      /* Card mode: a life-size ID-1 card (85.60 × 53.98 mm) over the ruler,
         sized via --ppc (CSS px per cm) */
      /* Sized to the visible area (set from JS too), so mobile browser
         toolbars can't hide the controls. Hint pinned top, controls bottom,
         and the card fills the middle, running behind the controls if it
         doesn't fit. */
      #card-mode {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 100vh;
        height: 100dvh;
        box-sizing: border-box;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        grid-template-columns: minmax(0, 1fr);
        justify-items: center;
        gap: 12px;
        padding: 12px 16px max(12px, env(safe-area-inset-bottom));
        pointer-events: none;
      }
      .card-stage {
        display: flex;
        justify-content: center;
        align-items: safe center;
        width: 100%;
        min-width: 0;
        min-height: 0;
      }
      .card-hint,
      .card-controls {
        position: relative;
        z-index: 1;
      }
      #card-mode[hidden] {
        display: none;
      }
      body.card-mode #title,
      body.card-mode #topbar,
      body.card-mode #panel,
      body.card-mode #readout {
        display: none;
      }
      .card-hint,
      .card-controls {
        box-sizing: border-box;
        max-width: min(440px, 100%);
        padding: 10px 14px;
        border-radius: 10px;
        border: 1px solid var(--border);
        background: var(--panel);
        font-size: 13px;
        text-align: center;
        pointer-events: auto;
      }
      .card-hint {
        margin: 0;
        color: var(--muted);
      }
      .card {
        --w: 8.56;
        --h: 5.398;
        position: relative;
        flex: none;
        width: calc(var(--w) * var(--ppc) * 1px);
        height: calc(var(--h) * var(--ppc) * 1px);
        border-radius: calc(0.318 * var(--ppc) * 1px);
        border: 1px dashed var(--accent);
        background: var(--accent-soft);
        opacity: 0.8;
      }
      /* Upright when the card is wider than the screen, e.g. a phone */
      .card.portrait {
        --w: 5.398;
        --h: 8.56;
      }
      .card .chip {
        position: absolute;
        left: calc(0.9 * var(--ppc) * 1px);
        top: calc(1.9 * var(--ppc) * 1px);
        width: calc(1.1 * var(--ppc) * 1px);
        height: calc(0.85 * var(--ppc) * 1px);
        border-radius: calc(0.12 * var(--ppc) * 1px);
        border: 1px solid var(--accent);
        opacity: 0.5;
      }
      .card.portrait .chip {
        left: calc(1.9 * var(--ppc) * 1px);
        top: calc(0.9 * var(--ppc) * 1px);
        width: calc(0.85 * var(--ppc) * 1px);
        height: calc(1.1 * var(--ppc) * 1px);
      }
      .card .dims {
        position: absolute;
        right: 10px;
        bottom: 8px;
        font-size: 11px;
        color: var(--accent);
      }
      .card-controls {
        width: 100%;
      }
      .slider-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .slider-row input {
        flex: 1;
        min-width: 0;
        accent-color: var(--accent);
      }
      .slider-row .btn {
        width: 32px;
        padding: 4px 0;
      }
      .slider-row output {
        width: 48px;
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: var(--muted);
      }
      .actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
      }
      .card-controls .actions {
        margin-top: 12px;
      }
      @media (max-width: 560px) {
        #status {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <canvas id="grid"></canvas>

    <div id="readout" class="hud"></div>

    <h1 id="title">Online ruler · actual size</h1>

    <div id="topbar">
      <span id="status"></span>
      <div class="units" role="group" aria-label="Units">
        <button data-unit="cm">cm</button>
        <button data-unit="in">in</button>
      </div>
      <button id="toggle-panel" class="btn">Calibrate</button>
    </div>

    <div id="panel" hidden>
      <h2>Your screen</h2>
      <p id="guess"></p>
      <p class="note" id="scale-info"></p>

      <h3>Not right?</h3>
      <input
        id="search"
        type="search"
        placeholder="Search, e.g. “air 15” or “27 4k”"
        autocomplete="off"
        spellcheck="false"
      />
      <ul id="results"></ul>

      <button id="show-card" class="link">Can't find it? Measure with a card</button>

      <h3>About</h3>
      <p class="note">
        Most online rulers assume every screen has 96 pixels per inch, so
        they're the wrong size on almost every device. This one works out which
        screen you have (iPhone, Android, iPad, Mac or Windows laptop) and uses
        its real pixel density, so a centimetre on screen is a real centimetre.
        If your device isn't listed, calibrate it once with any bank card.
      </p>

      <div class="actions">
        <span></span>
        <button id="done" class="btn primary">Done</button>
      </div>
    </div>

    <div id="card-mode" hidden>
      <p class="card-hint">
        Hold any bank card or driving licence against the outline and slide
        until the edges line up.
      </p>
      <div class="card-stage">
        <div class="card">
          <div class="chip"></div>
          <span class="dims">85.60 × 53.98 mm</span>
        </div>
      </div>
      <div class="card-controls">
        <div class="slider-row">
          <button id="adjust-down" class="btn" aria-label="Smaller">−</button>
          <input id="adjust" type="range" min="-50" max="100" step="0.05" value="0" />
          <button id="adjust-up" class="btn" aria-label="Bigger">+</button>
          <output id="adjust-out">0.0%</output>
        </div>
        <div class="actions">
          <button id="card-cancel" class="btn">Cancel</button>
          <button id="reset-adjust" class="link">Reset</button>
          <button id="card-done" class="btn primary">Done</button>
        </div>
      </div>
    </div>

    <script>
      // Screen specs. Modes are what the browser reports as screen.width ×
      // screen.height and devicePixelRatio, e.g. macOS "looks like" resolutions
      // or Windows scaling (dpr defaults to 2). Sizes are given as ppi, or as
      // diagonal inches for generic screens. os limits which devices count as
      // likely for the visitor's platform; screens without one fit any desktop.
