      // Calibration is stored per screen shape so a laptop and an external
      // monitor can each keep their own.
      function screenKey() {
        const [s, l] = sides(window.screen.width, window.screen.height);
        return (l / s).toFixed(2);
      }

      function loadAll() {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY)) || {};
        } catch {
          return {};
        }
      }

      function saveCalibration() {
        try {
          const all = loadAll();
          all[screenKey()] = { deviceId: calibration.deviceId, adjust: calibration.adjust };
          localStorage.setItem(STORAGE_KEY, JSON.stringify(all));
        } catch {}
      }

      // State
      let calibration = { deviceId: null, adjust: 0, saved: false };
      let candidates = [];
      let ppc = CSS_PX_PER_CM;
      let origin = null;
      let pointer = null;
      let pinned = null; // box corner as an offset from the origin, once fixed by a click
      let press = null; // where the current click started, until it becomes a drag
      let dragging = false;
      let clientModel = ""; // e.g. "Pixel 8", only available in Chrome on Android
      let unit = loadUnit();
      let cardMode = null; // { adjustBefore } while measuring with a card
      const DRAG_THRESHOLD = 4;

      const canvas = document.getElementById("grid");
      const ctx = canvas.getContext("2d");
      const searchInput = document.getElementById("search");
      const results = document.getElementById("results");
      const cardModeEl = document.getElementById("card-mode");
      const card = cardModeEl.querySelector(".card");
      const adjustInput = document.getElementById("adjust");
      const adjustOut = document.getElementById("adjust-out");
      const panel = document.getElementById("panel");

      function loadCalibration() {
        candidates = matchDevices({
          width: window.screen.width,
          height: window.screen.height,
          dpr: window.devicePixelRatio,
        });
        const saved = loadAll()[screenKey()];
        calibration = saved
          ? { ...saved, saved: true }
          : { deviceId: candidates[0]?.id ?? null, adjust: 0, saved: false };
      }

      function computePpc() {
        const d = DEVICES.find((x) => x.id === calibration.deviceId);
        const base = d ? Math.min(window.screen.width, window.screen.height) / shortSideCm(d) : CSS_PX_PER_CM;
        ppc = base * (1 + calibration.adjust / 100);
        document.documentElement.style.setProperty("--ppc", ppc);
      }

      function renderResults() {
        // Every word must appear in the name; ″ and punctuation are ignored
        const normalise = (t) => t.toLowerCase().replace(/[″"()]/g, " ");
        const words = normalise(searchInput.value).split(/\s+/).filter(Boolean);
        const matches = (d) => words.every((w) => normalise(d.name).includes(w));
        const list = [...candidates, ...DEVICES.filter((d) => !candidates.includes(d))].filter(matches);
        results.innerHTML = list.length
          ? list
              .map(
                (d) =>
                  `<li><button data-id="${d.id}" class="${d.id === calibration.deviceId ? "selected" : ""}">` +
                  `<span>${d.name}</span>` +
                  `<span class="tag">${d.id === calibration.deviceId ? "✓ selected" : candidates.includes(d) ? "likely" : ""}</span>` +
                  `</button></li>`,
              )
              .join("")
          : `<li class="empty">No matches. Try measuring with a card.</li>`;
      }

      function renderControls() {
        const d = DEVICES.find((x) => x.id === calibration.deviceId);
        const name = d ? d.name : "your screen";
        const physW = window.screen.width / ppc;
        const physH = window.screen.height / ppc;
        const diag = Math.hypot(physW, physH) / 2.54;
        const tuned = calibration.adjust ? " (card adjusted)" : "";

        const cardOnly = !d && calibration.saved && calibration.adjust;
        document.getElementById("guess").innerHTML = cardOnly
          ? "Using your card measurement"
          : !d
          ? "We couldn't recognise this screen. Search for it below, or measure with a card."
          : calibration.saved
            ? `Using <strong>${name}</strong>${tuned}`
            : `Looks like a <strong>${name}</strong>`;
        document.getElementById("scale-info").textContent =
          `Screen ≈ ${physW.toFixed(1)} × ${physH.toFixed(1)} cm (${diag.toFixed(1)}″) · ${ppc.toFixed(2)} px/cm. ` +
          `Keep browser zoom at 100% (⌘0). ` +
          `Browser reports ${window.screen.width} × ${window.screen.height} @ ${+window.devicePixelRatio.toFixed(3)}x` +
          `${clientModel ? `, ${clientModel}` : ""}.`;
        document.getElementById("status").textContent = d
          ? `${calibration.saved ? "" : "Guessed: "}${d.name}${tuned}`
          : cardOnly
            ? "Card calibrated"
            : "Unknown screen";

        adjustInput.value = calibration.adjust;
        adjustOut.textContent = `${calibration.adjust > 0 ? "+" : ""}${Number(calibration.adjust).toFixed(1)}%`;
        const portrait = window.innerWidth < 8.56 * ppc + 32;
        card.classList.toggle("portrait", portrait);
        document.querySelector(".card-hint").textContent = portrait
          ? "Hold any bank card or driving licence upright against the top of the outline, and slide until the left and right edges line up."
          : "Hold any bank card or driving licence against the outline and slide until the edges line up.";
        renderResults();
      }

      function update() {
        computePpc();
        renderControls();
        draw();
      }

      function commit() {
        calibration.saved = true;
        saveCalibration();
        update();
      }

      // --- Calibration controls --------------------------------------------

      function selectDevice(id) {
        calibration.deviceId = id;
        calibration.adjust = 0;
        commit();
      }

      searchInput.addEventListener("input", renderResults);
      searchInput.addEventListener("keydown", (e) => {
        const first = results.querySelector("button");
        if (e.key === "Enter" && first) selectDevice(first.dataset.id);
      });
      results.addEventListener("click", (e) => {
        const button = e.target.closest("button");
        if (button) selectDevice(button.dataset.id);
      });

      // Card mode takes over the ruler so the grid rescales live behind the card
      function setCardMode(on) {
        cardMode = on ? { adjustBefore: calibration.adjust } : null;
        cardModeEl.hidden = !on;
        document.body.classList.toggle("card-mode", on);
        pinned = null;
        if (on) origin = null; // centred, so the card sits symmetrically on the axes
        update();
      }

      function setAdjust(value) {
        calibration.adjust = Math.min(100, Math.max(-50, Math.round(value * 100) / 100));
        update();
      }

      document.getElementById("show-card").addEventListener("click", () => setCardMode(true));
      adjustInput.addEventListener("input", () => setAdjust(Number(adjustInput.value)));
      document.getElementById("adjust-down").addEventListener("click", () => setAdjust(calibration.adjust - 0.1));
      document.getElementById("adjust-up").addEventListener("click", () => setAdjust(calibration.adjust + 0.1));
      document.getElementById("reset-adjust").addEventListener("click", () => setAdjust(0));
      document.getElementById("card-cancel").addEventListener("click", () => {
        calibration.adjust = cardMode.adjustBefore;
        setCardMode(false);
      });
      document.getElementById("card-done").addEventListener("click", () => {
        setCardMode(false);
        commit();
        panel.hidden = true;
      });

      document.getElementById("toggle-panel").addEventListener("click", () => {
        panel.hidden = !panel.hidden;
      });
      document.getElementById("done").addEventListener("click", () => {
        commit();
        panel.hidden = true;
      });

      // --- Drawing ------------------------------------------------------------

      function draw() {
        const dpr = window.devicePixelRatio || 1;
        const w = window.innerWidth;
        const h = window.innerHeight;
        if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
          canvas.width = Math.round(w * dpr);
          canvas.height = Math.round(h * dpr);
        }
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        ctx.clearRect(0, 0, w, h);

        origin ??= { x: Math.round(w / 2), y: Math.round(h / 2) };
        const { x: ox, y: oy } = origin;
        const css = getComputedStyle(document.documentElement);
        const color = (name) => css.getPropertyValue(name).trim();
        // Snap to device pixels so 1px lines stay crisp
        const snap = (v) => (Math.round(v * dpr) + 0.5) / dpr;

        // Grid: whole and half unit lines, aligned to the origin
        const u = UNITS[unit];
        const upx = ppc * u.cm; // CSS px per unit
        const half = upx / 2;
        for (const [step, stroke, every] of [[half, "--grid-half", 2], [upx, "--grid-cm", 1]]) {
          ctx.strokeStyle = color(stroke);
          ctx.lineWidth = 1 / dpr;
          ctx.beginPath();
          for (let i = Math.floor(-ox / step); i <= (w - ox) / step; i++) {
            if (every === 2 && i % 2 === 0) continue;
            const x = snap(ox + i * step);
            ctx.moveTo(x, 0);
            ctx.lineTo(x, h);
          }
          for (let i = Math.floor(-oy / step); i <= (h - oy) / step; i++) {
            if (every === 2 && i % 2 === 0) continue;
            const y = snap(oy + i * step);
            ctx.moveTo(0, y);
            ctx.lineTo(w, y);
          }
          ctx.stroke();
        }

        const target = measureTarget();
        if (target) {
          ctx.fillStyle = color("--accent-soft");
          ctx.globalAlpha = 0.5;
          ctx.fillRect(Math.min(ox, target.x), Math.min(oy, target.y), Math.abs(target.x - ox), Math.abs(target.y - oy));
          ctx.globalAlpha = 1;
        }

        // Rulers: the axis line is the measuring edge, ticks hang off one side
        const sub = upx / u.divisions;
        ctx.strokeStyle = color("--tick");
        ctx.fillStyle = color("--tick");
        ctx.lineWidth = 1 / dpr;
        ctx.font = "500 11px Inter, system-ui, sans-serif";
        ctx.beginPath();
        ctx.moveTo(0, snap(oy));
        ctx.lineTo(w, snap(oy));
        ctx.moveTo(snap(ox), 0);
        ctx.lineTo(snap(ox), h);
        // Drop the finest ticks when they'd be closer than 3px
        const every = sub >= 3 ? 1 : u.minor;
        for (let i = Math.floor(-ox / sub); i <= (w - ox) / sub; i++) {
          if (i % every !== 0) continue;
          const x = snap(ox + i * sub);
          ctx.moveTo(x, oy);
          ctx.lineTo(x, oy + u.tickLen(i));
        }
        for (let i = Math.floor(-oy / sub); i <= (h - oy) / sub; i++) {
          if (i % every !== 0) continue;
          const y = snap(oy + i * sub);
          ctx.moveTo(ox, y);
          ctx.lineTo(ox + u.tickLen(i), y);
        }
        ctx.stroke();

        ctx.textAlign = "center";
        ctx.textBaseline = "top";
        for (let i = Math.ceil(-ox / upx); i <= (w - ox) / upx; i++) {
          if (i !== 0) ctx.fillText(String(Math.abs(i)), ox + i * upx, oy + 17);
        }
        ctx.textAlign = "left";
        ctx.textBaseline = "middle";
        for (let i = Math.ceil(-oy / upx); i <= (h - oy) / upx; i++) {
          if (i !== 0) ctx.fillText(String(Math.abs(i)), ox + 18, oy + i * upx);
        }

        // Pill with text, rotated by angle (radians) around its centre
        const pill = (text, cx, cy, { font = "600 12px Inter, system-ui, sans-serif", fg = color("--text"), angle = 0 } = {}) => {
          ctx.save();
          ctx.translate(cx, cy);
          ctx.rotate(angle);
          ctx.font = font;
          const tw = ctx.measureText(text).width + 12;
          ctx.fillStyle = color("--panel");
          ctx.strokeStyle = color("--border");
          ctx.beginPath();
          ctx.roundRect(-tw / 2, -10, tw, 20, 5);
          ctx.fill();
          ctx.stroke();
          ctx.fillStyle = fg;
          ctx.textAlign = "center";
          ctx.textBaseline = "middle";
          ctx.fillText(text, 0, 0.5);
          ctx.restore();
        };

        // Measurement box from origin to cursor, each edge labelled with its length
        if (target) {
          const { x: px, y: py } = target;
          const dx = Math.abs(px - ox) / upx;
          const dy = Math.abs(py - oy) / upx;
          ctx.strokeStyle = color("--accent");
          ctx.setLineDash([4, 4]);
          ctx.beginPath();
          ctx.moveTo(ox, py);
          ctx.lineTo(px, py);
          ctx.lineTo(px, oy);
          ctx.moveTo(ox, oy);
          ctx.lineTo(px, py);
          ctx.stroke();
          ctx.setLineDash([]);

          const sx = Math.sign(px - ox) || 1;
          const sy = Math.sign(py - oy) || 1;
          // Labels only once an edge is over 3 mm
          const minLabel = 0.3 / u.cm;
          if (dx > minLabel) pill(`${dx.toFixed(2)} ${unit}`, (ox + px) / 2, py + sy * 14);
          if (dy > minLabel) pill(`${dy.toFixed(2)} ${unit}`, px + sx * 14, (oy + py) / 2, { angle: -Math.PI / 2 });
          if (dx > minLabel && dy > minLabel) {
            // Along the diagonal, kept upright
            let angle = Math.atan2(py - oy, px - ox);
            if (angle > Math.PI / 2) angle -= Math.PI;
            if (angle < -Math.PI / 2) angle += Math.PI;
            pill(`${Math.hypot(dx, dy).toFixed(2)} ${unit}`, (ox + px) / 2, (oy + py) / 2, {
              font: "400 11px Inter, system-ui, sans-serif",
              fg: color("--muted"),
              angle,
            });
          }
        }

        ctx.fillStyle = color("--accent");
        ctx.beginPath();
        ctx.arc(ox, oy, 3, 0, Math.PI * 2);
        ctx.fill();

        renderReadout();
      }

      // The box follows the cursor unless a click has fixed it in place
      function measureTarget() {
        if (cardMode) return null;
        if (pinned) return { x: origin.x + pinned.x, y: origin.y + pinned.y };
        return dragging ? null : pointer;
      }

      function renderReadout() {
        const readout = document.getElementById("readout");
        const u = UNITS[unit];
        const help = `Click to fix the box · drag to move the grid · double-click to centre · arrow keys nudge ${u.nudge}`;
        const target = measureTarget();
        if (!target) {
          readout.textContent = help;
          return;
        }
        const dx = (target.x - origin.x) / (ppc * u.cm);
        const dy = (target.y - origin.y) / (ppc * u.cm);
        readout.innerHTML =
          `x <strong>${Math.abs(dx).toFixed(2)} ${unit}</strong> · y <strong>${Math.abs(dy).toFixed(2)} ${unit}</strong>` +
          ` · distance <strong>${Math.hypot(dx, dy).toFixed(2)} ${unit}</strong>`;
      }

      // --- Interaction --------------------------------------------------------

      // Drag pans the grid (a fixed box moves with it); a click without
      // dragging fixes the box at that point, and clicking again releases it.
      canvas.addEventListener("pointerdown", (e) => {
        canvas.setPointerCapture(e.pointerId);
        press = { x: e.clientX, y: e.clientY, origin: { ...origin } };
      });
      canvas.addEventListener("pointermove", (e) => {
        pointer = { x: e.clientX, y: e.clientY };
        if (press && !dragging && Math.hypot(pointer.x - press.x, pointer.y - press.y) > DRAG_THRESHOLD) {
          dragging = true;
          canvas.classList.add("dragging");
        }
        if (dragging) {
          origin = { x: press.origin.x + pointer.x - press.x, y: press.origin.y + pointer.y - press.y };
        }
        draw();
      });
      canvas.addEventListener("pointerup", (e) => {
        if (press && !dragging && !cardMode) {
          pinned = pinned ? null : { x: e.clientX - origin.x, y: e.clientY - origin.y };
        }
        press = null;
        dragging = false;
        canvas.classList.remove("dragging");
        draw();
      });
      canvas.addEventListener("pointerleave", () => {
        pointer = null;
        draw();
      });
      canvas.addEventListener("dblclick", () => {
        origin = null;
        pinned = null;
        draw();
      });

      window.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && cardMode) {
          document.getElementById("card-cancel").click();
          return;
        }
        if (e.key === "Escape") {
          panel.hidden = true;
          pinned = null;
          draw();
        }
        if (panel.contains(document.activeElement)) return;
        const u = UNITS[unit];
        const step = (e.shiftKey ? 1 : 1 / u.divisions) * ppc * u.cm;
        const moves = { ArrowLeft: [-step, 0], ArrowRight: [step, 0], ArrowUp: [0, -step], ArrowDown: [0, step] };
        if (!moves[e.key] || !origin) return;
        e.preventDefault();
        origin = { x: origin.x + moves[e.key][0], y: origin.y + moves[e.key][1] };
        draw();
      });

      // Zoom and moving between screens both fire resize
      // --- Units --------------------------------------------------------------

      const unitButtons = document.querySelectorAll(".units button");
      function renderUnits() {
        unitButtons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.unit === unit)));
      }
      unitButtons.forEach((b) =>
        b.addEventListener("click", () => {
          unit = b.dataset.unit;
          try {
            localStorage.setItem(UNIT_KEY, unit);
          } catch {}
          renderUnits();
          draw();
        }),
      );
      renderUnits();

      window.addEventListener("resize", () => {
        loadCalibration();
        update();
      });
      // Mobile toolbars shrink the visible area without always resizing the window
      const fitCardMode = () => {
        if (window.visualViewport) cardModeEl.style.height = `${window.visualViewport.height}px`;
      };
      window.visualViewport?.addEventListener("resize", fitCardMode);
      fitCardMode();
      window.matchMedia("(prefers-color-scheme: dark)").addEventListener("change", draw);
      document.fonts?.ready.then(draw);

      loadCalibration();
      if (!calibration.saved) panel.hidden = false;
      update();

      // Android Chrome can name the exact phone, which separates phones that
      // report identical screen sizes
      navigator.userAgentData?.getHighEntropyValues(["model"]).then(({ model }) => {
        if (!model) return;
        clientModel = model;
        loadCalibration();
        update();
      });
    </script>
  </body>
</html>
