        { id: "uw34", name: "34″ ultrawide monitor", native: [3440, 1440], diag: 34,
          modes: [[3440, 1440, 1]] },
      ];
      const CSS_PX_PER_CM = 96 / 2.54;
      const STORAGE_KEY = "ruler.calibration";
      const UNIT_KEY = "ruler.unit";

      // Each unit's length in cm and how its ticks subdivide: mm for cm,
      // sixteenths for inches with longer half/quarter/eighth marks
      const UNITS = {
        cm: { cm: 1, divisions: 10, minor: 5, nudge: "1 mm", tickLen: (i) => (i % 10 === 0 ? 14 : i % 5 === 0 ? 9 : 5) },
        in: {
          cm: 2.54,
          divisions: 16,
          minor: 2,
          nudge: "1/16 in",
          tickLen: (i) => (i % 16 === 0 ? 14 : i % 8 === 0 ? 11 : i % 4 === 0 ? 8 : i % 2 === 0 ? 6 : 4),
        },
      };

      // Inches in American time zones, cm elsewhere. The time zone comes from
      // the OS clock, so it's more reliable than the browser language, which
      // is often en-US (or plain "en", which maximizes to US) outside the US.
      function defaultUnit() {
        try {
          const zone = Intl.DateTimeFormat().resolvedOptions().timeZone;
          return zone.startsWith("America/") ? "in" : "cm";
        } catch {
          return "cm";
        }
      }

      function loadUnit() {
        try {
          const saved = localStorage.getItem(UNIT_KEY);
          if (saved in UNITS) return saved;
        } catch {}
        return defaultUnit();
      }

      // Everything is compared short side / long side, as phones rotate and iOS
      // never swaps screen.width and screen.height
      const sides = (a, b) => [Math.min(a, b), Math.max(a, b)];

      function shortSideCm(d) {
        const [s, l] = sides(...d.native);
        return d.ppi ? (s / d.ppi) * 2.54 : (d.diag * 2.54 * s) / Math.hypot(s, l);
      }

      function clientOs() {
        const ua = navigator.userAgent;
        if (/iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)) return "ios";
        if (/Android/.test(ua)) return "android";
        if (/Macintosh/.test(ua)) return "mac";
        return "windows";
      }

      // Rank devices against a reported screen: exact mode first, then by how
      // close the aspect ratio is to the native panel.
      function matchDevices({ width, height, dpr }) {
        const [s, l] = sides(width, height);
        const os = clientOs();
        const mobile = os === "ios" || os === "android";
        const scored = [];
        for (const d of DEVICES) {
          const modelMatch = (m) => m === clientModel || (m.startsWith("SM-") && clientModel.startsWith(m));
          if (clientModel && d.models?.some(modelMatch)) {
            scored.push({ device: d, score: -1 });
            continue;
          }
          if (d.os ? d.os !== os : mobile) continue;
          const mode = d.modes.find(([w, h]) => {
            const [ms, ml] = sides(w, h);
            return Math.abs(ms - s) <= 1 && Math.abs(ml - l) <= 2;
          });
          const [ns, nl] = sides(...d.native);
          const aspectDiff = Math.abs(l / s - nl / ns) / (nl / ns);
          let score;
          if (mode) score = Math.abs(dpr - (mode[2] ?? 2)) < 0.02 ? 0 : 1;
          else if (aspectDiff < 0.01) score = 2 + aspectDiff * 100;
          else continue;
          scored.push({ device: d, score });
