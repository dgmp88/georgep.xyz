<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Lucia's Birthday Concert Menu</title>
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Lora:ital,wght@0,400;0,500;1,400&display=swap"
            rel="stylesheet"
        />
        <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            :root {
                --cream: #fff9f0;
                --dark: #2c2416;
                --accent: #b8860b;
                --light-accent: #d4af37;
                --gray: #665544;
                --light-gray: #e8dcc8;
            }

            body {
                font-family: "Lora", serif;
                background: linear-gradient(
                    135deg,
                    var(--cream) 0%,
                    #fff5e6 100%
                );
                color: var(--dark);
                line-height: 1.6;
                min-height: 100vh;
                padding: 2rem 1rem;
            }

            .container {
                max-width: 900px;
                margin: 0 auto;
                background: white;
                box-shadow:
                    0 20px 60px rgba(0, 0, 0, 0.12),
                    0 0 1px rgba(0, 0, 0, 0.1);
                border-radius: 2px;
                overflow: hidden;
            }

            .header {
                background: linear-gradient(to bottom, var(--dark), #3a2e1e);
                padding: 3rem 2rem 2rem;
                text-align: center;
                position: relative;
                border-bottom: 3px solid var(--accent);
            }

            .violin-icon {
                width: 80px;
                height: 80px;
                margin: 0 auto 1.5rem;
                opacity: 0.9;
                animation: fadeIn 1s ease-in;
            }

            .violin-icon img {
                width: 100%;
                height: 100%;
                filter: brightness(0) invert(1);
            }

            h1 {
                font-family: "Cormorant Garamond", serif;
                font-size: 2.8rem;
                font-weight: 600;
                color: var(--cream);
                margin-bottom: 0.5rem;
                letter-spacing: 0.02em;
                animation: fadeIn 1s ease-in 0.2s backwards;
            }

            .subtitle {
                font-family: "Cormorant Garamond", serif;
                font-size: 1.2rem;
                color: var(--light-accent);
                font-style: italic;
                animation: fadeIn 1s ease-in 0.4s backwards;
            }

            .intro {
                padding: 2.5rem 2rem;
                text-align: center;
                background: var(--cream);
                border-bottom: 1px solid var(--light-gray);
            }

            .intro p {
                font-size: 1.1rem;
                color: var(--gray);
                max-width: 600px;
                margin: 0 auto;
                line-height: 1.7;
            }

            .concerts {
                padding: 2rem;
            }

            .genre-section {
                margin-bottom: 3rem;
                animation: fadeIn 0.8s ease-in backwards;
            }

            .genre-section:nth-child(1) {
                animation-delay: 0.1s;
            }
            .genre-section:nth-child(2) {
                animation-delay: 0.2s;
            }

            .genre-header {
                font-family: "Cormorant Garamond", serif;
                font-size: 1.8rem;
                font-weight: 600;
                color: var(--accent);
                margin-bottom: 1.5rem;
                padding-bottom: 0.5rem;
                border-bottom: 2px solid var(--light-accent);
                display: flex;
                align-items: center;
                gap: 0.8rem;
            }

            .genre-icon {
                font-size: 1.5rem;
            }

            .concert {
                padding: 1.5rem;
                margin-bottom: 1.5rem;
                background: white;
                border: 1px solid var(--light-gray);
                border-left: 4px solid var(--accent);
                transition: all 0.3s ease;
                position: relative;
            }

            .concert:hover {
                transform: translateX(4px);
                box-shadow: 0 4px 20px rgba(184, 134, 11, 0.15);
                border-left-color: var(--light-accent);
            }

            .concert-date {
                font-family: "Cormorant Garamond", serif;
                font-size: 0.95rem;
                color: var(--accent);
                font-weight: 500;
                margin-bottom: 0.5rem;
                letter-spacing: 0.03em;
            }

            .concert-title {
                font-size: 1.3rem;
                font-weight: 500;
                color: var(--dark);
                margin-bottom: 0.5rem;
                line-height: 1.3;
            }

            .concert-venue {
                font-size: 0.95rem;
                color: var(--gray);
                margin-bottom: 0.8rem;
            }

            .concert-description {
                font-size: 0.95rem;
                color: var(--gray);
                line-height: 1.6;
                margin-bottom: 1rem;
            }

            .concert-link {
                display: inline-block;
                color: var(--accent);
                text-decoration: none;
                font-weight: 500;
                font-size: 0.9rem;
                padding: 0.5rem 1.2rem;
                border: 1.5px solid var(--accent);
                border-radius: 2px;
                transition: all 0.3s ease;
                letter-spacing: 0.02em;
            }

            .concert-link:hover {
                background: var(--accent);
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(184, 134, 11, 0.3);
            }

            .footer {
                background: var(--dark);
                color: var(--cream);
                text-align: center;
                padding: 2rem;
                font-style: italic;
            }

            @keyframes fadeIn {
                from {
                    opacity: 0;
                    transform: translateY(10px);
                }
                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            @media (max-width: 768px) {
                body {
                    padding: 0;
                }

                .container {
                    border-radius: 0;
                }

                h1 {
                    font-size: 2rem;
                }

                .header,
                .intro,
                .concerts {
                    padding: 1.5rem 1rem;
                }

                .concert {
                    padding: 1rem;
                }
            }
        </style>
    </head>
