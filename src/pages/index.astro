---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Background from '../components/Background.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Background />
    <Header />
    <div class="hero min-h-screen">
      <div class="hero-content prose text-center max-w-lg glass rounded-lg">
        <div>
          <img
            class="rounded-lg w-lg"
            src="/images/me.jpg"
            alt="George"
          />
        </div>
        <div>
          <h2 class="text-gray-100">Hi. I'm George</h2>
          <p>
            <a
              class="link text-gray-100"
              href="https://linkedin.com/in/george-prichard"
            >
              LinkedIn
            </a>
          </p>
          <p>
            <a
              class="link text-gray-100"
              href="https://github.com/dgmp88"
            >
              Github
            </a>
          </p>
        </div>
      </div>
    </div>
  </body>
</html>
