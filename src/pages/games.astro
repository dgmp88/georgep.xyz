---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Background from '../components/Background.astro';
import { Play } from '../components/Play.jsx';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={`Games | ${SITE_TITLE}`} description="Browser games" />
  </head>
  <body>
    <Background />
    <Header />
    <main class="on-dark max-w-3xl mx-auto px-4 pt-24 pb-20">
      <div class="prose lg:prose-lg max-w-none">
        <h1 class="font-display font-normal">Games</h1>
        <p>
          These were originally made as android apps using{' '}
          <a href="https://libgdx.com/">LibGDX</a> several years back. They're
          now relatively easy to compile for the browser, so it's fun to have
          them here. They may be a touch buggy, but the core features seem to
          work.
        </p>
        <h2 class="font-display font-normal">Dinowar</h2>
        <p>
          Dinosaur strategy game made with{' '}
          <a href="https://www.dglencross.com/">David</a> and graphics by{' '}
          <a href="https://emile.work">Emile</a>.
        </p>
        <Play client:load game="dinowar" />
        <h2 class="pt-12 font-display font-normal">Lunee</h2>
        <p>Physics based space game. Graphics by me, sorry about that.</p>
        <Play client:load game="lunee" />
      </div>
    </main>
  </body>
</html>

